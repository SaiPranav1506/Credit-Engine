@startuml C4_Context_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context Diagram - Credit Decision Engine

Person(officer, "Credit Officer", "Uploads financial documents, GST data, bank statements, and officer notes")
System(creditEngine, "Credit Decision Engine", "Transformer-based credit analysis system that automates credit decisions using AI/ML models on 4GB VRAM GPU")

System_Ext(gpu, "NVIDIA GPU (CUDA 12.1)", "Provides GPU acceleration for model inference (~3.2 GB VRAM)")
System_Ext(huggingface, "HuggingFace Model Hub", "Hosts pre-trained models: TinyLlama-1.1B, DistilBERT, MiniLM-L6-v2")

Rel(officer, creditEngine, "Uploads PDF, GST CSV, Bank CSV, Officer Notes", "Gradio Web UI")
Rel(creditEngine, officer, "Returns APPROVE/REJECT decision, Five Cs analysis, CAM PDF report")
Rel(creditEngine, gpu, "Runs model inference", "PyTorch CUDA")
Rel(creditEngine, huggingface, "Downloads pre-trained weights", "HTTPS")

@enduml


@startuml C4_Container_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container Diagram - Credit Decision Engine

Person(officer, "Credit Officer", "Uploads documents and reviews credit decisions")

System_Boundary(creditEngine, "Credit Decision Engine") {
    Container(ui, "Gradio Web UI", "Python / Gradio 4.44", "Web interface with tabs: Decision, Five Cs, Narrative, Status. Port 7860")
    Container(parser, "PDF Parser", "DistilBERT + PyMuPDF", "Extracts financials (15 metrics), risk indicators, and classifies document sections via zero-shot NLP. ~400MB VRAM")
    Container(fraud, "Fraud Detector", "NetworkX + Pandas", "Builds GST transaction graph. Detects circular trading cycles, amount anomalies (z-score), concentration risk. ~0 VRAM")
    Container(rag, "Research RAG", "FAISS + MiniLM-L6-v2", "Embeds documents into 384-dim FAISS index. Retrieves top-k relevant chunks for context-augmented scoring. ~200MB VRAM")
    Container(scorer, "Credit Scorer", "TinyLlama-1.1B 4-bit (NF4)", "Rule-based Five Cs scoring (Character, Capacity, Capital, Collateral, Conditions) + LLM narrative generation. ~1.2GB VRAM")
    Container(cam, "CAM PDF Generator", "ReportLab", "Generates Credit Appraisal Memorandum PDF report with Five Cs table, financial highlights, fraud analysis")
    ContainerDb(db, "Decision Database", "SQLite3", "Stores all credit decisions with timestamps, scores, applicant info")
    ContainerDb(faissIdx, "FAISS Vector Index", "FAISS CPU", "In-memory vector store for document embeddings (384-dim)")
}

Rel(officer, ui, "Uploads PDF + GST CSV + Bank CSV + Notes", "HTTP / Browser")
Rel(ui, parser, "Step 1: Parse financial PDF", "Python call")
Rel(ui, fraud, "Step 2: Analyze GST transactions", "Python call")
Rel(ui, rag, "Step 4: Retrieve research context", "Python call")
Rel(ui, scorer, "Step 5: Score credit application", "Python call")
Rel(ui, cam, "Step 7: Generate CAM PDF", "Python call")
Rel(ui, db, "Step 6: Save decision", "SQLite3")
Rel(rag, faissIdx, "Embeds & queries document chunks", "FAISS L2 search")
Rel(ui, officer, "Returns decision, Five Cs, narrative, CAM PDF", "HTTP / Browser")

@enduml


@startuml C4_Component_Diagram_Parser
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Component Diagram - PDF Parser (parser.py)

Container_Boundary(parser, "PDF Parser Module") {
    Component(pdfExtract, "PDF Text Extractor", "PyMuPDF (fitz)", "Extracts raw text from uploaded PDF bytes or file path")
    Component(regexEngine, "Financial Regex Engine", "Python re", "15 regex patterns extract: Revenue, Net Profit, EBITDA, Total Assets, Liabilities, Current Assets/Liabilities, Net Worth, Debt, Interest Expense, Depreciation, Tax, Cash Flow")
    Component(ratioCalc, "Ratio Calculator", "Python", "Derives 5 ratios: Debt-to-Asset, Debt-to-Equity, Current Ratio, Interest Coverage, Net Margin")
    Component(riskDetector, "Risk Detector", "Python NLP", "Scans sentences for 14 risk keywords (default, NPA, fraud, litigation...) and 10 positive keywords. Computes risk density %")
    Component(sectionClassifier, "Section Classifier", "DistilBERT zero-shot", "Classifies text chunks into: Income Statement, Balance Sheet, Cash Flow, Auditor Report, Notes, Management Discussion")
}

Rel(pdfExtract, regexEngine, "Raw text")
Rel(regexEngine, ratioCalc, "Extracted financials")
Rel(pdfExtract, riskDetector, "Raw text sentences")
Rel(pdfExtract, sectionClassifier, "Text chunks (500 char)")

@enduml


@startuml C4_Component_Diagram_Fraud
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Component Diagram - Fraud Detector (fraud.py)

Container_Boundary(fraud, "Fraud Detector Module") {
    Component(graphBuilder, "Graph Builder", "NetworkX DiGraph", "Builds directed graph: nodes=GSTINs, edges=transactions with amount weights")
    Component(cycleDetector, "Circular Trading Detector", "NetworkX simple_cycles", "Finds trading loops (3-6 entities). HIGH severity >= 4 entities, MEDIUM = 3 entities")
    Component(anomalyDetector, "Amount Anomaly Detector", "Z-score Statistical Analysis", "Flags transactions with |z-score| > 2 std deviations. HIGH > 3 std, MEDIUM 2-3 std")
    Component(concentrationAnalyzer, "Concentration Risk Analyzer", "Threshold Analysis", "Flags single-counterparty concentration > 70% of inflow or outflow")
    Component(fraudScorer, "Fraud Scorer", "Weighted Aggregation", "fraud_score = min(100, HIGH_flags * 25 + MEDIUM_flags * 10)")
}

Rel(graphBuilder, cycleDetector, "DiGraph")
Rel(graphBuilder, anomalyDetector, "Edge amounts")
Rel(graphBuilder, concentrationAnalyzer, "Node flow stats")
Rel(cycleDetector, fraudScorer, "Cycle flags")
Rel(anomalyDetector, fraudScorer, "Anomaly flags")
Rel(concentrationAnalyzer, fraudScorer, "Concentration flags")

@enduml


@startuml C4_Component_Diagram_Scorer
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Component Diagram - Credit Scorer (scorer.py)

Container_Boundary(scorer, "Credit Scorer Module") {
    Component(fiveCsEngine, "Five Cs Rule Engine", "Python", "Computes weighted scores:\n- Character (20%): 100 - fraud*1.5\n- Capacity (25%): margin + coverage\n- Capital (20%): D/E + net worth\n- Collateral (15%): current ratio + assets\n- Conditions (20%): bank balance + EMI ratio")
    Component(decisionLogic, "Decision Logic", "Python", "APPROVE: score >= 60\nREVIEW: 40 < score < 60\nREJECT: score <= 40")
    Component(loanCalc, "Loan Limit Calculator", "Python", "loan_limit = revenue * 0.4 * (score/100)\nrisk_premium = 2% + (100-score) * 0.05")
    Component(narrativeGen, "Narrative Generator", "TinyLlama-1.1B 4-bit", "Generates AI credit analysis narrative using quantized LLM with RAG context")
}

Rel(fiveCsEngine, decisionLogic, "Weighted credit score")
Rel(decisionLogic, loanCalc, "Score + decision")
Rel(fiveCsEngine, narrativeGen, "Five Cs scores + financials + fraud data")

@enduml


@startuml C4_Full_Pipeline_Sequence
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Credit Decision Pipeline - Full Sequence Flow

actor "Credit Officer" as officer
participant "Gradio UI\n(app.py)" as ui
participant "PDF Parser\n(DistilBERT)" as parser
participant "Fraud Detector\n(NetworkX)" as fraud
participant "Bank Analyzer\n(Pandas)" as bank
participant "Research RAG\n(FAISS)" as rag
participant "Credit Scorer\n(TinyLlama)" as scorer
database "SQLite DB" as db
participant "CAM Generator\n(ReportLab)" as cam

officer -> ui : Upload PDF + GST CSV + Bank CSV + Notes
activate ui

== Step 1: Document Parsing ==
ui -> parser : parse(pdf_bytes)
activate parser
parser -> parser : extract_text_from_bytes()
parser -> parser : extract_financials() [15 metrics + 5 ratios]
parser -> parser : detect_risks() [14 risk + 10 positive keywords]
parser -> parser : classify_sections() [DistilBERT zero-shot]
parser --> ui : {financials, risks, sections}
deactivate parser

== Step 2: Fraud Detection ==
ui -> fraud : analyze(gst_dataframe)
activate fraud
fraud -> fraud : build_graph() [GSTIN nodes, transaction edges]
fraud -> fraud : detect_circular_trading() [cycles 3-6 entities]
fraud -> fraud : detect_amount_anomalies() [z-score > 2σ]
fraud -> fraud : detect_concentration_risk() [> 70% threshold]
fraud --> ui : {fraud_score, flags, cycles, anomalies}
deactivate fraud

== Step 3: Bank Statement Analysis ==
ui -> bank : analyze_bank_csv(bank_dataframe)
activate bank
bank -> bank : Calculate avg_balance, total_inflow, total_outflow
bank -> bank : Compute EMI-to-income ratio
bank --> ui : {avg_balance, inflow, outflow, emi_ratio}
deactivate bank

== Step 4: RAG Context Retrieval ==
ui -> rag : build_context("credit risk factors for {applicant}")
activate rag
rag -> rag : query FAISS index [top-5 chunks, 384-dim cosine sim]
rag --> ui : formatted_context_string
deactivate rag

== Step 5: Credit Scoring ==
ui -> scorer : score(financials, fraud_result, bank_metrics, rag_context, notes)
activate scorer
scorer -> scorer : _compute_five_cs() [rule-based: Character, Capacity, Capital, Collateral, Conditions]
scorer -> scorer : Apply weights [0.20, 0.25, 0.20, 0.15, 0.20]
scorer -> scorer : Decision logic [APPROVE ≥ 60 | REVIEW 40-60 | REJECT ≤ 40]
scorer -> scorer : Calculate loan_limit & risk_premium
scorer -> scorer : _generate_narrative() [TinyLlama 4-bit inference]
scorer --> ui : {credit_score, decision, loan_limit, risk_premium, five_cs, narrative}
deactivate scorer

== Step 6: Save to Database ==
ui -> db : INSERT decision record
db --> ui : OK

== Step 7: Generate CAM PDF ==
ui -> cam : generate(score_result, financials, fraud_result, applicant_name)
activate cam
cam -> cam : Build header + executive summary
cam -> cam : Five Cs analysis table
cam -> cam : Financial highlights section
cam -> cam : Fraud & risk analysis section
cam -> cam : AI recommendation narrative
cam --> ui : cam_pdf_bytes + file_path
deactivate cam

ui --> officer : Decision Tab + Five Cs Tab + Narrative Tab + Status Tab + CAM PDF Download
deactivate ui

@enduml
