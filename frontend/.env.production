# Frontend Environment for Production (Render)
# The VITE_API_URL will be injected by Render from the backend service URL

# API Configuration - Render will auto-inject from backend service
# VITE_API_URL is set by Render runtime environment
VITE_API_URL=https://credit-engine-87ef.onrender.com

# Application Settings
VITE_API_TIMEOUT=30000
VITE_LOG_LEVEL=info
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true

# Sentry (Optional - Error Tracking)
VITE_SENTRY_DSN=

# Analytics (Optional)
VITE_GA_TRACKING_ID=
