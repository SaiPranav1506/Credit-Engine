# Frontend Environment for Production (Vercel)
# This file is for Vercel environment variables
# Add these to Vercel project settings: Settings > Environment Variables

# API Configuration - Set this to your Render backend URL
# Example: https://credit-engine-backend.onrender.com
VITE_API_URL=https://credit-engine-backend.onrender.com

# Application Settings
VITE_API_TIMEOUT=30000
VITE_LOG_LEVEL=info
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true

# Sentry (Optional - Error Tracking)
VITE_SENTRY_DSN=

# Analytics (Optional)
VITE_GA_TRACKING_ID=
