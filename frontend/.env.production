# Frontend Environment for Production (Render)
# IMPORTANT: VITE_API_URL is injected by Render at runtime from backend service
# Do NOT hardcode the URL here - it will be overridden by Render's environment injection

# API Configuration
# In production: Render injects VITE_API_URL from the backend service URL
# Fallback for local testing: http://localhost:5000
VITE_API_URL=${VITE_API_URL:-http://localhost:5000}

# Application Settings
VITE_API_TIMEOUT=30000
VITE_LOG_LEVEL=info
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false

# Sentry (Optional - Error Tracking)
VITE_SENTRY_DSN=

# Analytics (Optional)
VITE_GA_TRACKING_ID=
